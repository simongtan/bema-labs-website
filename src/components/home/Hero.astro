---
/**
 * Home hero (SITE-SPEC §5 #1, COPY §1.1). Owned by home. Services only; nothing about products.
 *
 * Fold rule: at 360×640 and 1366×768 the H1, the lead and the primary CTA are visible without
 * scrolling. To keep that true:
 *  - the CTA row follows the lead directly, with the outcome list below it;
 *  - the H1 runs one step smaller than inner pages (32 → 56 px), because this line is long;
 *  - below 480 px the eyebrow is hidden (the lead repeats its words) and the lead uses body size.
 * Desktop: copy left, "A typical flow" card right over a faint square grid. Mobile: card stacks
 * below the copy.
 */
import Button from '../Button.astro';
import ArrowLink from '../ArrowLink.astro';
import Check from '../icons/Check.astro';
import FlowCard from './FlowCard.astro';

const outcomes = [
  "Enter information once and let it flow where it's needed",
  'Catch missing details before they cause rework',
  "See what's waiting, what's changed and who has it",
];
---

<section class="hero" aria-labelledby="page-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">Workflow automation · Integrations · Dashboards</p>
      <h1 id="page-title" class="hero__title">
        Practical automation for the admin that slows your operation down.
      </h1>
      <p class="lead hero__lead">
        BEMA Labs designs and builds workflow automation, integrations and dashboards for
        manufacturing, construction and other operations businesses. We start with how the work is
        really done, agree the scope before we build, and keep your people in charge of the
        decisions that matter.
      </p>
      <div class="hero__actions">
        <Button href="/contact/">Arrange a walkthrough</Button>
        <ArrowLink href="/how-we-work/">See how we work</ArrowLink>
      </div>
      <ul class="hero__outcomes" role="list" aria-label="What changes">
        {
          outcomes.map((item) => (
            <li>
              <Check size={20} class="hero__check" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      {/* [CONFIRM] COPY §1.1 location line (register #5): ships as written. Source-only marker. */}
      <p class="hero__location">
        Based in Bathurst, NSW. On-site walkthroughs across the Central West.
      </p>
    </div>
    <div class="hero__aside">
      <FlowCard />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-16);
    background: var(--color-bg);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-12);
  }

  /* The lead repeats these words, so small phones skip the eyebrow to keep the CTA in view. */
  .hero__eyebrow {
    display: none;
  }

  .hero__title {
    font-size: clamp(2rem, 1.35rem + 2.8vw, 3.5rem);
  }

  .hero__lead {
    margin-top: var(--space-4);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
  }

  .hero__actions :global(.btn) {
    width: 100%;
  }

  .hero__outcomes {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }

  .hero__outcomes li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .hero__outcomes :global(.hero__check) {
    margin-top: 0.2em;
    color: var(--color-brand);
  }

  .hero__location {
    margin-top: var(--space-6);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  @media (min-width: 480px) {
    .hero__eyebrow {
      display: block;
      margin-bottom: var(--space-4);
    }

    .hero__lead {
      margin-top: var(--space-6);
      font-size: var(--text-lead);
      line-height: 1.55;
    }

    .hero__actions {
      margin-top: var(--space-8);
    }

    .hero__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 720px) {
    .hero {
      padding-block: var(--space-12) var(--space-16);
    }

    .hero__copy {
      max-width: 44rem;
    }

    .hero__aside {
      max-width: 30rem;
    }
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: var(--space-16) var(--space-24);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 22rem);
      align-items: center;
      column-gap: var(--space-12);
    }

    .hero__copy,
    .hero__aside {
      max-width: none;
    }

    /* Faint square grid behind the flow card (brand graphic language). CSS only: no image
       request and never an LCP candidate. */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0 0 0 45%;
      background-image:
        linear-gradient(to right, var(--color-border) 1px, transparent 1px),
        linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
      background-size: var(--space-12) var(--space-12);
      -webkit-mask-image: radial-gradient(closest-side at 62% 50%, #000, transparent);
      mask-image: radial-gradient(closest-side at 62% 50%, #000, transparent);
      opacity: 0.8;
      pointer-events: none;
    }
  }

  @media (min-width: 1080px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 23rem;
      column-gap: var(--space-16);
    }
  }
</style>

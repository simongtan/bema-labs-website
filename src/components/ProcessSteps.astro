---
/**
 * The five-step process (data: src/data/process.ts).
 * variant: summary (title + body, grid) | detailed (adds "You get" outputs, stacked rows).
 * Step numbers are visual only (aria-hidden); the <ol> carries the numbering for assistive tech.
 */
import { processSteps } from '../data/process';

interface Props {
  variant?: 'summary' | 'detailed';
  headingLevel?: 2 | 3;
}

const { variant = 'summary', headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class="process" data-variant={variant} role="list">
  {
    processSteps.map((step) => (
      <li class="process__step">
        <span class="process__num" aria-hidden="true">
          {String(step.n).padStart(2, '0')}
        </span>
        <div class="process__content">
          <div class="process__main">
            <Heading class="process__title">{step.title}</Heading>
            <p class="process__body">{step.body}</p>
          </div>
          {variant === 'detailed' && (
            <div class="process__outputs">
              <p class="process__outputs-label">You get</p>
              <ul class="list-check" role="list">
                {step.outputs.map((output) => (
                  <li>{output}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .process {
    list-style: none;
  }

  .process__num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-brand);
    font-variant-numeric: tabular-nums;
  }

  .process__title {
    font-size: var(--text-h3);
  }

  .process__body {
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
  }

  /* Summary: compact grid with a rule above each step */
  .process[data-variant='summary'] {
    display: grid;
    gap: var(--space-8) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr));
  }

  .process[data-variant='summary'] .process__step {
    padding-top: var(--space-4);
    border-top: var(--rule-width) solid var(--color-border);
  }

  .process[data-variant='summary'] .process__step:first-child {
    border-top-color: var(--color-accent);
  }

  .process[data-variant='summary'] .process__num {
    margin-bottom: var(--space-3);
  }

  .process[data-variant='summary'] .process__body {
    font-size: var(--text-small);
  }

  @media (min-width: 1080px) {
    .process[data-variant='summary'] {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Detailed: one row per step */
  .process[data-variant='detailed'] .process__step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .process[data-variant='detailed'] .process__step:last-child {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .process[data-variant='detailed'] .process__num {
    font-size: 2rem;
  }

  .process[data-variant='detailed'] .process__content {
    display: grid;
    gap: var(--space-6);
  }

  .process[data-variant='detailed'] .process__main {
    max-width: 40rem;
  }

  .process__outputs-label {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .process__outputs {
    font-size: var(--text-small);
  }

  @media (min-width: 720px) {
    .process[data-variant='detailed'] .process__step {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .process[data-variant='detailed'] .process__num {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 960px) {
    .process[data-variant='detailed'] .process__content {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }
</style>
